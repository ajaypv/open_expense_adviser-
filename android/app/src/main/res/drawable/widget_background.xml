<?xml version="1.0" encoding="utf-8"?>
<!-- The card both widgets sit on: a soft top-to-bottom wash and a hairline edge, in the phone's light or dark colours. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_background_bottom"
        android:startColor="@color/widget_background_top" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_edge" />
    <corners android:radius="26dp" />
</shape>
